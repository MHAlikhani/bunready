{
  "name": "@mh-alikhani/bunready",
  "version": "0.4.4",
  "description": "Bun-readiness scanner: one command that shows what will break before you move a Node/TS repo to Bun.",
  "keywords": [
    "bun",
    "bun-readiness",
    "node",
    "nodejs",
    "typescript",
    "migration",
    "compatibility",
    "cli",
    "scanner",
    "static-analysis",
    "monorepo",
    "workspaces",
    "lockfile",
    "sarif",
    "ci",
    "code-quality",
    "developer-tools",
    "devtools",
    "dependency-analysis"
  ],
  "license": "MIT",
  "author": "Mohammad Hosein Alikhani",
  "type": "module",
  "private": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "bunready": "./src/cli/index.ts"
  },
  "files": [
    "src",
    "docs",
    "action.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "trustedDependencies": [
    "simple-git-hooks"
  ],
  "scripts": {
    "bunready": "bun run src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "build": "bun build ./src/cli/index.ts --target=bun --outdir=dist",
    "check": "bun run typecheck && bun run lint && bun run test",
    "og": "bun run scripts/generate-og-image.ts",
    "smoke": "bun run scripts/smoke-real.ts",
    "bench": "bun run scripts/bench.ts",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@resvg/resvg-js": "^2",
    "@types/bun": "^1",
    "simple-git-hooks": "^2",
    "typescript": "^7"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx biome check --staged --no-errors-on-unmatched && bunx tsc --noEmit",
    "commit-msg": "bunx commitlint --edit \"$1\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MHAlikhani/bunready.git"
  },
  "homepage": "https://github.com/MHAlikhani/bunready#readme",
  "bugs": {
    "url": "https://github.com/MHAlikhani/bunready/issues"
  }
}
